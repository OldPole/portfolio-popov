# Optional: enable delivery from the contact form with a Resend account.
# Use a sender address on a domain verified in that account.
NUXT_RESEND_API_KEY=
NUXT_CONTACT_FROM=
NUXT_CONTACT_TO=ipetr6828@gmail.com
# Set the exact public origin when deploying, e.g. https://portfolio.example.com
NUXT_CONTACT_ALLOWED_ORIGIN=
# Set the final public origin BEFORE npm run build to generate canonical URLs,
# hreflang, social previews and sitemap links. Leave empty for local development.
NUXT_PUBLIC_SITE_URL=
